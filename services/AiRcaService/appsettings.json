{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Loki": {
    "BaseUrl": "http://loki:3100",
    "TimeoutSeconds": 30
  },
  "InternalLlm": {
    "BaseUrl": "http://internal-llm:11434",
    "ApiKey": "",
    "Model": "llama3",
    "MaxTokens": 4096,
    "MaxInputTokens": 50000
  },
  "RateLimit": {
    "RequestsPerHour": 10
  },
  "Analysis": {
    "MaxLogLines": 5000,
    "MaxWindowMinutes": 60
  },
  "Jaeger": {
    "BaseUrl": "http://jaeger:16686",
    "TimeoutSeconds": 10
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Seq": { "Url": "http://seq:5341" },
  "Urls": "http://+:5013"
}
