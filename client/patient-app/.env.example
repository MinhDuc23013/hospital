# =============================================================================
# Patient App — Environment Variables Template
# Copy to .env.local for local development. NEVER commit .env.local.
# =============================================================================

# NEXTAUTH_URL: Public URL the browser uses to reach this app.
# In Docker: set to your host URL (e.g. http://localhost:3100)
# In production: set to your real domain (e.g. https://patient.hospital.com)
# Must exactly match Keycloak's Valid Redirect URIs.
NEXTAUTH_URL=http://localhost:3100

# NEXTAUTH_SECRET: Secret used to sign/encrypt session tokens.
# Generate with: openssl rand -base64 32
# NEVER use a default value. NEVER commit this.
NEXTAUTH_SECRET=

# Keycloak OIDC client credentials
KEYCLOAK_CLIENT_ID=hospital-patient-portal
KEYCLOAK_CLIENT_SECRET=

# Keycloak issuer URL
# Dev (host machine): http://localhost:8080/realms/hospital
# Docker internal:    http://keycloak:8080/realms/hospital
KEYCLOAK_ISSUER=http://localhost:8080/realms/hospital

# API Gateway URL — server-only, NO NEXT_PUBLIC_ prefix.
# Never expose the gateway URL to the browser bundle (defeats proxy pattern).
# Dev (host machine): http://localhost:8000
# Docker internal:    http://hospital-gateway:8000
GATEWAY_API_URL=http://localhost:8000

# PUBLIC Keycloak base URL (browser-facing) for SSO logout redirect.
# Must be reachable from the user's browser — NOT the Docker-internal hostname.
# Dev: http://localhost:8080 | Production: https://auth.hospital.com
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
