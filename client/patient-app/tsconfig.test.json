{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "jsx": "react-jsx"
  },
  "include": [
    "vitest.config.ts",
    "vitest.setup.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "lib/**/*.ts",
    "components/**/*.tsx",
    "components/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
