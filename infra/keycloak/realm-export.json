{
  "realm": "hospital",
  "displayName": "Hospital HRM",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      { "name": "admin", "description": "System administrator" },
      { "name": "doctor", "description": "Medical doctor" },
      { "name": "nurse", "description": "Nurse" },
      { "name": "pharmacist", "description": "Pharmacy staff" },
      { "name": "receptionist", "description": "Front desk receptionist" },
      { "name": "patient", "description": "Patient portal user" }
    ]
  },
  "clients": [
    {
      "clientId": "hospital-gateway",
      "name": "Hospital API Gateway",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8000/*",
        "http://hospital-gateway:8000/*"
      ],
      "webOrigins": ["*"],
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"]
    },
    {
      "clientId": "hospital-frontend",
      "name": "Hospital Frontend App",
      "enabled": true,
      "publicClient": false,
      "secret": "hospital-frontend-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"]
    },
    {
      "clientId": "hospital-patient-portal",
      "name": "Hospital Patient Portal",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "change_me_secret",
      "redirectUris": [
        "http://localhost:3100/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3100",
        "http://localhost:3000"
      ],
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"]
    }
  ],
  "users": [
    {
      "username": "admin-user",
      "email": "admin@hospital.local",
      "firstName": "System",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Admin1234!", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "doctor-user",
      "email": "doctor@hospital.local",
      "firstName": "John",
      "lastName": "Smith",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Doctor1234!", "temporary": false }],
      "realmRoles": ["doctor"]
    }
  ]
}
